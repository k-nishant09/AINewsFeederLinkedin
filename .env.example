# =============================================================================
# AI Daily News Platform — Environment Configuration
# Copy to .env and fill in real values. Never commit .env to Git.
# =============================================================================

# --- LLM Gateway — IBM OpenShift Model Gateway --------------------------------
# Endpoint:  https://model-gateway-model-gateway.apps.f73l056.fusion.tadn.ibm.com
# Swagger:   https://swagger-ui-model-gateway.apps.f73l056.fusion.tadn.ibm.com
# Backstage: https://backstage-developer-hub-rhdh-operator.apps.f73l056.fusion.tadn.ibm.com
#            (search: llm-inference-gateway)
#
# Available models (GET /v1/models):
#   qwen2-5-72b-instruct   — Qwen 2.5 72B Instruct (chat / reasoning)  ← default
#   granite-embedding-125m — IBM Granite 125M (embeddings only)
#
# Quick test:
#   curl -k https://model-gateway-model-gateway.apps.f73l056.fusion.tadn.ibm.com/v1/models \
#        -H 'Authorization: Bearer <your-llm-api-key>'
#
# The gateway is OpenAI-compatible — LangChain ChatOpenAI works unchanged.
LLM_API_KEY=<your-llm-api-key>
LLM_BASE_URL=https://model-gateway-model-gateway.apps.f73l056.fusion.tadn.ibm.com/v1
LLM_MODEL=qwen2-5-72b-instruct

# --- MCP Server URLs (injected by OpenShift ConfigMap in production) ---------
# Local development (docker compose):
NEWS_MCP_URL=http://localhost:8101/mcp
PAGEINDEX_MCP_URL=http://localhost:8102/mcp
EVALUATION_MCP_URL=http://localhost:8103/mcp
LINKEDIN_MCP_URL=http://localhost:8104/mcp

# OpenShift production (set in ConfigMap, not here):
# NEWS_MCP_URL=https://news-mcp.apps.<cluster>/mcp
# PAGEINDEX_MCP_URL=https://pageindex-mcp.apps.<cluster>/mcp
# EVALUATION_MCP_URL=https://evaluation-mcp.apps.<cluster>/mcp
# LINKEDIN_MCP_URL=https://linkedin-mcp.apps.<cluster>/mcp

# --- MCP Auth ----------------------------------------------------------------
MCP_AUTH_TOKEN=change-me-in-production

# =============================================================================
# GNews API  (News MCP — news_search_latest, news_search_ai_tech, news_search_ai_finance)
# API docs: https://docs.gnews.io
# =============================================================================
# 1. Sign up at https://gnews.io  (free plan: 100 requests/day, max 10 articles/request)
# 2. After email confirmation go to Dashboard → API Key → copy it
# 3. Key format: 32-char hex string  e.g. xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# GNews endpoints used internally:
#   GET https://gnews.io/api/v4/search           — keyword search with date filter
#   GET https://gnews.io/api/v4/top-headlines    — topic-based top headlines
#
# Params: q, apikey, lang, country, max (1-10 free), from (ISO-8601), in, sortby
#
# How to verify your key works (curl):
#   curl -s "https://gnews.io/api/v4/search?q=artificial+intelligence&lang=en&country=us&max=3&apikey=$GNEWS_API_KEY" \
#        | python3 -m json.tool | head -60
#
# AI tech news test:
#   curl -s "https://gnews.io/api/v4/search?q=LLM+agentic+AI&lang=en&max=3&apikey=$GNEWS_API_KEY" \
#        | python3 -m json.tool
#
# AI finance news test:
#   curl -s "https://gnews.io/api/v4/search?q=AI+finance+investment+funding&lang=en&max=3&apikey=$GNEWS_API_KEY" \
#        | python3 -m json.tool
#
# Top technology headlines test:
#   curl -s "https://gnews.io/api/v4/top-headlines?topic=technology&lang=en&max=5&apikey=$GNEWS_API_KEY" \
#        | python3 -m json.tool
# =============================================================================
GNEWS_API_KEY=<your-gnews-api-key>
GNEWS_MAX_PER_REQUEST=10    # free plan: 10 max; paid plans: up to 100
GNEWS_REQUEST_DELAY_MS=1100 # free plan: 1 req/sec; set to 0 on paid plans

# =============================================================================
# LinkedIn API  (LinkedIn MCP — linkedin_create_post)
# =============================================================================
# Community server reference: github.com/souravdasbiswas/linkedin-mcp-server
#
# Step-by-step to get credentials:
# 1. Go to https://www.linkedin.com/developers/apps/new
# 2. Create an app — note Client ID and Client Secret
# 3. Add "Share on LinkedIn" and "Sign In with LinkedIn" OAuth scopes
# 4. Under Auth → OAuth 2.0 tools → Generate a 3-legged token
#    Scopes required:  w_member_social  r_liteprofile
# 5. The resulting access token looks like: AQV...  (~200+ chars)
#
# How to verify your token (curl):
#   curl -s -H "Authorization: Bearer $LINKEDIN_ACCESS_TOKEN" \
#        -H "LinkedIn-Version: 202504" \
#        "https://api.linkedin.com/rest/userinfo" \
#        | python3 -m json.tool
#
# Token lifetime: typically 60 days; refresh before expiry.
# =============================================================================
LINKEDIN_CLIENT_ID=<your-linkedin-client-id>
LINKEDIN_CLIENT_SECRET=<your-linkedin-client-secret>

# Phase 1 (POC): generate token manually from LinkedIn Developer Portal → Token Generator.
# Phase 2 (Prod): complete OAuth flow via GET http://localhost:8104/oauth/start
#   → LinkedIn consent page → /oauth/callback → token stored automatically.
# Token lifetime: ~60 days. Rotate or enable programmatic refresh tokens.
LINKEDIN_ACCESS_TOKEN=AQV...          # 3-legged OAuth Bearer token (w_member_social scope)

# Refresh token (optional) — requires "Programmatic Refresh Tokens" enabled on your LinkedIn app.
# Ref: https://learn.microsoft.com/en-us/linkedin/shared/authentication/programmatic-refresh-tokens
LINKEDIN_REFRESH_TOKEN=

# OAuth callback URI — must exactly match the redirect URI configured in your LinkedIn app.
# Local dev:   http://localhost:8104/oauth/callback
# OpenShift:   https://linkedin-mcp.apps.<cluster-domain>/oauth/callback
LINKEDIN_REDIRECT_URI=http://localhost:8104/oauth/callback

# --- App -------------------------------------------------------------------
APP_ENV=development          # development | staging | production
LOG_LEVEL=INFO
RUN_ID_PREFIX=RUN

# --- Workflow Schedule -------------------------------------------------------
WORKFLOW_TIMEZONE=Asia/Kolkata
# CronJob schedule: 06:00 IST = 00:30 UTC
WORKFLOW_CRON_SCHEDULE="30 0 * * *"

# --- Observability -----------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Langfuse LLM tracing — https://langfuse.com
# US cloud: https://us.cloud.langfuse.com
# EU cloud: https://cloud.langfuse.com
# Self-hosted: http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com

# --- Database (optional persistence) ----------------------------------------
DATABASE_URL=postgresql+asyncpg://daily_news:password@localhost:5432/daily_news
